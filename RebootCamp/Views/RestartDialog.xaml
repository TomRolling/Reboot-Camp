<Window x:Class="RebootCamp.Views.RestartDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Redémarrage nécessaire"
        Width="460" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True">

    <!-- Petite fenêtre qui demande l'accord avant de redémarrer le PC. Rien ne redémarre sans un clic ici. -->
    <Border BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="28,26,28,22">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE777;" Style="{StaticResource IconText}" FontSize="26" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock Text="Redémarrage nécessaire" FontSize="20" FontWeight="SemiBold" Margin="14,0,0,0"
                           VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="ReasonText" TextWrapping="Wrap" Margin="0,18,0,0" />
            <TextBlock Text="Enregistre ton travail avant de redémarrer. Si tu choisis « Plus tard », rien ne se passe : tu redémarreras quand tu voudras."
                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Style="{StaticResource GhostButton}" Content="Plus tard" Padding="18,9" IsCancel="True" IsDefault="True" />
                <Button Style="{StaticResource PrimaryButton}" Content="Redémarrer maintenant" Padding="18,9" Margin="10,0,0,0"
                        Click="OnRestartNow" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
