<UserControl x:Class="RebootCamp.Views.ComposantsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RebootCamp.Controls">
    <UserControl.Resources>
        <!-- Regroupe les composants par famille (DirectX, Visual C++, .NET) -->
        <CollectionViewSource x:Key="GroupedItems" Source="{Binding Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Avant la première vérification : juste le gros bouton, au centre -->
        <ContentControl Grid.RowSpan="4" Content="{Binding}" ContentTemplate="{StaticResource StartHero}" Focusable="False"
                        Visibility="{Binding HasScanned, Converter={StaticResource EqualsToVis}, ConverterParameter=False}" />

        <!-- Après la vérification : en-tête compact (bouton rond + résultat + action principale) -->
        <Grid Margin="0,0,0,22" Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <c:RingButton Width="128" Height="128"
                          Command="{Binding RingCommand}" IsBusy="{Binding IsBusy}" Progress="{Binding Progress}"
                          Content="{Binding RingText}" Caption="{Binding RingCaption}" />
            <StackPanel Grid.Column="1" Margin="26,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Headline}" Style="{StaticResource HeadlineText}" />
                <TextBlock Text="{Binding SubText}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Margin="0,6,0,0" MaxHeight="40" />
            </StackPanel>
            <!-- Visible seulement s'il manque quelque chose et que rien n'est en cours -->
            <Grid Grid.Column="2" VerticalAlignment="Center"
                  Visibility="{Binding IsBusy, Converter={StaticResource EqualsToVis}, ConverterParameter=False}">
                <Button Style="{StaticResource PrimaryButton}" Content="Installer ce qui manque"
                        Command="{Binding InstallMissingCommand}"
                        Visibility="{Binding MissingCount, Converter={StaticResource EqualsToVis}, ConverterParameter=!0}" />
            </Grid>
        </Grid>

        <!-- Avertissement si winget est absent -->
        <Border Grid.Row="1" Style="{StaticResource Card}" BorderBrush="{StaticResource WarningBrush}" Margin="0,0,0,14"
                Visibility="{Binding WingetWarning, Converter={StaticResource EqualsToVis}, ConverterParameter=!}">
            <TextBlock Text="{Binding WingetWarning}" TextWrapping="Wrap" />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedItems}}" Focusable="False">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="14,14,0,4"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowBorder}" Padding="14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Style="{StaticResource StatusIcon}" Content="{Binding Status}" HorizontalAlignment="Left" />
                                <StackPanel Grid.Column="1" Margin="6,0,14,0">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource SmallMutedText}" />
                                </StackPanel>
                                <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="12,5" FontSize="12.5"
                                        Content="{Binding ActionLabel}" VerticalAlignment="Center"
                                        Command="{Binding DataContext.InstallOneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding DataContext.IsBusy, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EqualsToVis}, ConverterParameter=False}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Sortie de winget en direct -->
        <TextBox Grid.Row="3" Style="{StaticResource LogBox}" Text="{Binding Log.Text, Mode=OneWay}" Height="120" Margin="0,14,0,0"
                 Visibility="{Binding ShowLog, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
