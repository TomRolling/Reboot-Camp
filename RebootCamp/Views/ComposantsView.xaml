<UserControl x:Class="RebootCamp.Views.ComposantsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RebootCamp.Controls">
    <UserControl.Resources>
        <!-- Regroupe les composants par famille (DirectX, Visual C++, .NET) -->
        <CollectionViewSource x:Key="GroupedItems" Source="{Binding Items}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Avant la première vérification : juste le gros bouton, au centre -->
        <ContentControl Grid.RowSpan="5" Content="{Binding}" ContentTemplate="{StaticResource StartHero}" Focusable="False"
                        Visibility="{Binding HasScanned, Converter={StaticResource EqualsToVis}, ConverterParameter=False}" />

        <!-- Après la vérification : en-tête compact (bouton rond + résultat) -->
        <Grid Margin="0,0,0,22" Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:RingButton Width="128" Height="128"
                          Command="{Binding RingCommand}" IsBusy="{Binding IsBusy}" Progress="{Binding Progress}"
                          Content="{Binding RingText}" Caption="{Binding RingCaption}" Outcome="{Binding Outcome}" />
            <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Headline}" Style="{StaticResource HeadlineText}" />
                <TextBlock Text="{Binding SubText}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Margin="0,6,0,0" MaxHeight="40" />
            </StackPanel>
        </Grid>

        <!-- Avertissement si winget est absent -->
        <Border Grid.Row="1" Style="{StaticResource Card}" BorderBrush="{StaticResource WarningBrush}" Margin="0,0,0,14"
                Visibility="{Binding WingetWarning, Converter={StaticResource EqualsToVis}, ConverterParameter=!}">
            <TextBlock Text="{Binding WingetWarning}" TextWrapping="Wrap" />
        </Border>

        <!-- Une ligne par composant. Rouge = manquant, orange = mise à jour disponible, vert = à jour.
             Seules les lignes où il y a quelque chose à faire ont une case à cocher. -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedItems}}" Focusable="False">
                <ItemsControl.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Margin="14,14,0,4"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ItemsControl.GroupStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowBorder}" Padding="14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="30" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}"
                                          Visibility="{Binding NeedsAction, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Grid.Column="1" Margin="14,0">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                                               Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                </StackPanel>
                                <ContentControl Grid.Column="2" Style="{StaticResource StatusIcon}" Content="{Binding Status}"
                                                HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Barre d'action : visible seulement s'il reste quelque chose à installer ou à mettre à jour et que rien n'est en cours -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <DockPanel.Style>
                <Style TargetType="DockPanel">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasPendingActions}" Value="True" />
                                <Condition Binding="{Binding IsBusy}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </DockPanel.Style>
            <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Installer la sélection"
                    Command="{Binding InstallSelectedCommand}" MinWidth="130" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding SelectionText}" VerticalAlignment="Center" Margin="0,0,18,0"
                       Foreground="{StaticResource TextMutedBrush}" />
            <Button DockPanel.Dock="Left" Style="{StaticResource GhostButton}" Content="Tout cocher / décocher"
                    Command="{Binding SelectAllCommand}" />
        </DockPanel>

        <!-- Sortie de winget en direct -->
        <TextBox Grid.Row="4" Style="{StaticResource LogBox}" Text="{Binding Log.Text, Mode=OneWay}" Height="120" Margin="0,14,0,0"
                 Visibility="{Binding ShowLog, Converter={StaticResource BoolToVis}}" />
    </Grid>
</UserControl>
