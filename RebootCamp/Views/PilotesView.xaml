<UserControl x:Class="RebootCamp.Views.PilotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:RebootCamp.Controls">
    <UserControl.Resources>
        <!-- Boutons « page du fabricant » (seulement ceux qui servent sur ce PC) -->
        <DataTemplate x:Key="LinkButton">
            <Button Style="{StaticResource GhostButton}" Content="{Binding Label}" Margin="0,0,8,0" ToolTip="{Binding ToolTip}"
                    Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}" />
        </DataTemplate>
        <ItemsPanelTemplate x:Key="HorizontalPanel">
            <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Avant la première analyse : juste le gros bouton, au centre -->
        <ContentControl Grid.RowSpan="2" Content="{Binding}" ContentTemplate="{StaticResource StartHero}" Focusable="False"
                        Visibility="{Binding HasScanned, Converter={StaticResource EqualsToVis}, ConverterParameter=False}" />

        <!-- Après l'analyse : en-tête compact (bouton rond + résultat) -->
        <Grid Margin="0,0,0,22" Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <c:RingButton Width="128" Height="128"
                          Command="{Binding RingCommand}" IsBusy="{Binding IsBusy}" Progress="{Binding Progress}"
                          Content="{Binding RingText}" Caption="{Binding RingCaption}" />
            <StackPanel Grid.Column="1" Margin="26,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Headline}" Style="{StaticResource HeadlineText}" />
                <TextBlock Text="{Binding SubText}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Margin="0,6,0,0" MaxHeight="40" />
            </StackPanel>
        </Grid>

        <!-- Résultats -->
        <Grid Grid.Row="1" Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ListBox Style="{StaticResource SegmentedTabs}" ItemsSource="{Binding Tabs}"
                     SelectedIndex="{Binding SelectedTab}" Margin="0,0,0,12" />

            <!-- 1. Mises à jour disponibles -->
            <Grid Grid.Row="1" Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=0}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel>
                    <!-- Explications et boutons du fabricant : sous la liste, ou en haut de la page quand il n'y a rien à installer -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="DockPanel.Dock" Value="Bottom" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Updates.Count}" Value="0">
                                        <Setter Property="DockPanel.Dock" Value="Top" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding UpdatesMessage}" Style="{StaticResource MutedText}"
                                   TextWrapping="Wrap" Margin="14,10" LineHeight="22" />
                        <ItemsControl ItemsSource="{Binding Links}" Margin="14,0,0,0" Focusable="False"
                                      ItemTemplate="{StaticResource LinkButton}" ItemsPanel="{StaticResource HorizontalPanel}" />
                    </StackPanel>

                    <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding Updates}" VerticalAlignment="Top"
                             Visibility="{Binding Updates.Count, Converter={StaticResource EqualsToVis}, ConverterParameter=!0}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Plus de case à cocher une fois le pilote installé -->
                                    <CheckBox IsChecked="{Binding IsSelected}"
                                              Visibility="{Binding Status, Converter={StaticResource EqualsToVis}, ConverterParameter=!Ok}" />
                                    <StackPanel Grid.Column="1" Margin="14,0">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource SmallMutedText}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="260" />
                                    <ContentControl Grid.Column="3" Style="{StaticResource StatusIcon}" Content="{Binding Status}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- Barre d'action : visible seulement s'il reste un pilote à installer et que rien n'est en cours -->
                <DockPanel Grid.Row="1" Margin="0,14,0,0" LastChildFill="False">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding HasPendingUpdates}" Value="True" />
                                        <Condition Binding="{Binding IsBusy}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DockPanel.Style>
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Installer la sélection"
                            Command="{Binding InstallCommand}" />
                    <CheckBox DockPanel.Dock="Left" Margin="14,0,0,0" IsChecked="{Binding CreateRestorePoint}"
                              Content="Point de restauration avant"
                              ToolTip="Permet de revenir en arrière si un pilote pose problème (recommandé)" />
                    <CheckBox DockPanel.Dock="Left" Margin="22,0,0,0" IsChecked="{Binding BackupDrivers}"
                              Content="Sauvegarder les pilotes actuels"
                              ToolTip="Copie les pilotes installés dans C:\ProgramData\RebootCamp\SauvegardePilotes (quelques minutes, 1 à 3 Go)" />
                </DockPanel>
            </Grid>

            <!-- 2. Périphériques en erreur -->
            <DockPanel Grid.Row="1" Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=1}">
                <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding Links}" Margin="14,10,0,0" Focusable="False"
                              ItemTemplate="{StaticResource LinkButton}" ItemsPanel="{StaticResource HorizontalPanel}" />
                <TextBlock DockPanel.Dock="Top" Text="Aucun périphérique en erreur. Tout fonctionne." Style="{StaticResource MutedText}" Margin="14,10"
                           Visibility="{Binding Problems.Count, Converter={StaticResource EqualsToVis}, ConverterParameter=0}" />
                <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding Problems}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <ContentControl DockPanel.Dock="Left" Style="{StaticResource StatusIcon}" Content="{Binding Status}" />
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource SmallMutedText}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <!-- 3. Tous les pilotes installés -->
            <Grid Grid.Row="1" Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=2}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <TextBox Style="{StaticResource SearchBox}" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Rechercher un pilote ou un fabricant…" Margin="12,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding FilterText, Converter={StaticResource EqualsToVis}, ConverterParameter=''}" />
                </Grid>
                <ListBox Grid.Row="1" Style="{StaticResource RowList}" ItemsSource="{Binding Drivers}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource SmallMutedText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Date}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                           TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
