<Window x:Class="RebootCamp.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True">

    <!-- Petite fenêtre de confirmation (redémarrer le PC, désinstaller un programme). Rien ne se fait sans un clic
         sur le bouton bleu ; Échap, Entrée et le bouton de gauche ferment sans rien faire. -->
    <Border x:Name="Frame" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="28,26,28,22">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="IconText" Style="{StaticResource IconText}" FontSize="26" VerticalAlignment="Center"
                           Foreground="{StaticResource AccentBrush}" />
                <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" Margin="14,0,0,0"
                           VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="370" />
            </StackPanel>

            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Margin="0,18,0,0" />
            <TextBlock x:Name="HintText" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Padding="18,9" IsCancel="True" IsDefault="True" />
                <Button x:Name="ConfirmButton" Style="{StaticResource PrimaryButton}" Padding="18,9" Margin="10,0,0,0"
                        Click="OnConfirm" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
