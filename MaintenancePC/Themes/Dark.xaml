<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Couleurs du thème sombre. Tout le reste de l'appli les utilise par leur nom. -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#15171C" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1B1E25" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#232730" />
    <SolidColorBrush x:Key="HoverBrush" Color="#262A34" />
    <SolidColorBrush x:Key="SelectedBrush" Color="#2B3140" />
    <SolidColorBrush x:Key="BorderBrush" Color="#2E333D" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DF6" />
    <SolidColorBrush x:Key="TextBrush" Color="#E6E8EC" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#9AA1AD" />

    <!-- Couleurs d'état (OK / à mettre à jour / erreur), utilisées à partir de la phase 2. -->
    <SolidColorBrush x:Key="OkBrush" Color="#3FB950" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D29922" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#F85149" />

    <!-- Police d'icônes fournie avec Windows (Fluent sur Windows 11, MDL2 sur Windows 10). -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Élément de la barre latérale : icône + titre, barre bleue à gauche quand il est sélectionné. -->
    <Style x:Key="SidebarItemStyle" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Root" Background="Transparent" CornerRadius="6" Margin="8,2" Padding="0,10">
                        <Grid>
                            <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="2"
                                    HorizontalAlignment="Left" Background="{StaticResource AccentBrush}"
                                    Visibility="Hidden" />
                            <ContentPresenter Margin="16,0,12,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource HoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource SelectedBrush}" />
                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
