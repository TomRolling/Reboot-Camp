<Window x:Class="MaintenancePC.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MaintenancePC.ViewModels"
        xmlns:views="clr-namespace:MaintenancePC.Views"
        xmlns:c="clr-namespace:MaintenancePC.Controls"
        Title="MaintenancePC"
        Width="1040" Height="680" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Quel écran afficher pour quel ViewModel -->
        <DataTemplate DataType="{x:Type vm:AccueilViewModel}">
            <views:AccueilView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PilotesViewModel}">
            <views:PilotesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogicielsViewModel}">
            <views:LogicielsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:NettoyageViewModel}">
            <views:NettoyageView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ComposantsViewModel}">
            <views:ComposantsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExtrasViewModel}">
            <views:ExtrasView />
        </DataTemplate>
    </Window.Resources>

    <!-- « Host » prend toute la fenêtre ; « Root » est l'interface, dessinée pour 1040 x 680 puis agrandie ou
         réduite d'un seul bloc (voir OnHostSizeChanged) : tout garde les mêmes proportions à n'importe quelle taille. -->
    <Border x:Name="Host" SizeChanged="OnHostSizeChanged">
    <Grid x:Name="Root">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Barre latérale -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="MaintenancePC" FontSize="18" FontWeight="SemiBold"
                           Margin="26,26,24,22" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding Version, StringFormat=Version {0}}"
                           Margin="26,0,24,18" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" />

                <!-- Encart « nouvelle version » : n'apparaît que si une version plus récente est publiée -->
                <Border DockPanel.Dock="Bottom" Margin="12,0,12,14" Padding="14,12" CornerRadius="10"
                        Background="{StaticResource CardBackgroundBrush}"
                        BorderBrush="{StaticResource AccentBrush}" BorderThickness="1"
                        Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding UpdateText}" FontSize="12.5" TextWrapping="Wrap" />
                        <Button Style="{StaticResource PrimaryButton}" Content="Mettre à jour" Padding="10,7" FontSize="12.5"
                                Margin="0,10,0,0" Command="{Binding InstallUpdateCommand}"
                                Visibility="{Binding UpdateInProgress, Converter={StaticResource EqualsToVis}, ConverterParameter=False}" />
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}"
                         ItemContainerStyle="{StaticResource SidebarItemStyle}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}"
                                           FontSize="16" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Contenu de l'onglet sélectionné (apparaît en fondu) -->
        <!-- Largeur plafonnée : en plein écran le contenu reste groupé au centre au lieu de s'étirer d'un bord à l'autre -->
        <c:AnimatedContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" MaxWidth="1180" />
    </Grid>
    </Border>
</Window>
