<UserControl x:Class="MaintenancePC.Views.ExtrasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MaintenancePC.Controls">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,18">
            <TextBlock Text="Extras" Style="{StaticResource HeadlineText}" />
            <TextBlock Text="Démarrage, infos système, santé des disques et outils de réparation."
                       Style="{StaticResource MutedText}" Margin="0,6,0,0" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="False">
            <ListBox DockPanel.Dock="Left" Style="{StaticResource SegmentedTabs}" ItemsSource="{Binding Tabs}"
                     SelectedIndex="{Binding SelectedTab}" />
            <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Padding="12,6" Content="Actualiser"
                    Command="{Binding RefreshCommand}"
                    Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=!3}" />
        </DockPanel>

        <!-- 1. Programmes au démarrage -->
        <Grid Grid.Row="2" Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=0}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl ItemsSource="{Binding StartupEntries}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Command}" Style="{StaticResource SmallMutedText}" ToolTip="{Binding Command}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Source}" Style="{StaticResource MutedText}" FontSize="12"
                                               VerticalAlignment="Center" Margin="0,0,18,0" />
                                    <ToggleButton Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled}"
                                                  ToolTip="Activer ou désactiver au démarrage (rien n'est supprimé)" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="1" Text="{Binding StartupMessage}" Style="{StaticResource MutedText}" Margin="14,10,0,0" />
        </Grid>

        <!-- 2. Infos système -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=1}">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding InfoLines}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding Volumes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding Name}" />
                                    </DockPanel>
                                    <ProgressBar Margin="0,8,0,0" Maximum="100" c:Behaviors.SmoothValue="{Binding UsedPercent}"
                                                 Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Santé des disques -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=2}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Disks}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <DockPanel>
                                    <ContentControl DockPanel.Dock="Left" Style="{StaticResource StatusIcon}" Content="{Binding Status}"
                                                    Margin="0,0,16,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource SmallMutedText}" />
                                        <TextBlock Text="{Binding HealthText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource SmallMutedText}"
                                                   Visibility="{Binding Details, Converter={StaticResource EqualsToVis}, ConverterParameter=!}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding SmartSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="4,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- 4. Réparation -->
        <Grid Grid.Row="2" Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=3}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <UniformGrid Columns="3" Margin="-6,0">
                <Button Style="{StaticResource CardButton}" Margin="6,0" Command="{Binding SfcCommand}">
                    <StackPanel>
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource IconText}" HorizontalAlignment="Left"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Vérifier les fichiers système" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="sfc /scannow" Style="{StaticResource SmallMutedText}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CardButton}" Margin="6,0" Command="{Binding DismCommand}">
                    <StackPanel>
                        <TextBlock Text="&#xE90F;" Style="{StaticResource IconText}" HorizontalAlignment="Left"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Réparer l'image Windows" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="DISM /RestoreHealth" Style="{StaticResource SmallMutedText}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CardButton}" Margin="6,0" Command="{Binding RestorePointCommand}">
                    <StackPanel>
                        <TextBlock Text="&#xE81C;" Style="{StaticResource IconText}" HorizontalAlignment="Left"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Créer un point de restauration" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Pour revenir en arrière si besoin" Style="{StaticResource SmallMutedText}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Grid Grid.Row="1" Margin="0,16,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding RepairStatus}" TextWrapping="Wrap" />
                    <ProgressBar Margin="0,10,0,0" Maximum="100" c:Behaviors.SmoothValue="{Binding Progress}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Annuler" Margin="16,0,0,0"
                        VerticalAlignment="Center" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <TextBox Grid.Row="2" Style="{StaticResource LogBox}" Text="{Binding RepairLog.Text, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
