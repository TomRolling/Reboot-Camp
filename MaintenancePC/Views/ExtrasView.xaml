<UserControl x:Class="MaintenancePC.Views.ExtrasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MaintenancePC.Controls">
    <UserControl.Resources>
        <!-- Une ligne « dossier ou fichier + taille + barre », cliquable pour l'ouvrir dans l'Explorateur -->
        <DataTemplate x:Key="FolderRow">
            <Button Style="{StaticResource CardButton}" Padding="14,10" Margin="0,0,0,6"
                    Command="{Binding DataContext.OpenInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    CommandParameter="{Binding}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" FontWeight="SemiBold" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ProgressBar Margin="0,8,0,0" Maximum="100" Height="4" c:Behaviors.SmoothValue="{Binding Percent}" />
                    <TextBlock Text="{Binding Note}" Style="{StaticResource SmallMutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Visibility="{Binding Note, Converter={StaticResource EqualsToVis}, ConverterParameter=!}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="Exporter un rapport" HorizontalAlignment="Right"
                        Command="{Binding ExportReportCommand}"
                        ToolTip="Crée un fichier texte qui résume ce PC : pratique à envoyer à quelqu'un qui t'aide à distance" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Extras" Style="{StaticResource HeadlineText}" />
                <TextBlock Text="{Binding ReportMessage, TargetNullValue='', FallbackValue=''}" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                           Visibility="{Binding ReportMessage, Converter={StaticResource EqualsToVis}, ConverterParameter=!}" />
                <TextBlock Text="Démarrage, infos système, santé des disques, sécurité et outils de réparation."
                           Style="{StaticResource MutedText}" Margin="0,6,0,0"
                           Visibility="{Binding ReportMessage, Converter={StaticResource EqualsToVis}, ConverterParameter=''}" />
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="False">
            <ListBox DockPanel.Dock="Left" Style="{StaticResource SegmentedTabs}" ItemsSource="{Binding Tabs}"
                     SelectedIndex="{Binding SelectedTab}" />
            <Button DockPanel.Dock="Right" Content="Actualiser" Command="{Binding RefreshCommand}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                        <Setter Property="Padding" Value="12,6" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="4">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding SelectedTab}" Value="5">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </DockPanel>

        <!-- 1. Programmes au démarrage -->
        <Grid Grid.Row="2" Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=0}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <ItemsControl ItemsSource="{Binding StartupEntries}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RowBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Command}" Style="{StaticResource SmallMutedText}" ToolTip="{Binding Command}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
                                        <TextBlock Text="{Binding Advice}" FontSize="12" HorizontalAlignment="Right"
                                                   Foreground="{Binding AdviceStatus, Converter={StaticResource StatusBrush}}"
                                                   Visibility="{Binding Advice, Converter={StaticResource EqualsToVis}, ConverterParameter=!}" />
                                        <TextBlock Text="{Binding Source}" Style="{StaticResource MutedText}" FontSize="12"
                                                   HorizontalAlignment="Right" />
                                    </StackPanel>
                                    <ToggleButton Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled}"
                                                  ToolTip="Activer ou désactiver au démarrage (rien n'est supprimé)" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="1" Text="{Binding StartupMessage}" Style="{StaticResource MutedText}" Margin="14,10,0,0" />
        </Grid>

        <!-- 2. Infos système -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=1}">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding InfoLines}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <ItemsControl ItemsSource="{Binding Volumes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,8">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Text}" Foreground="{StaticResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding Name}" />
                                    </DockPanel>
                                    <ProgressBar Margin="0,8,0,0" Maximum="100" c:Behaviors.SmoothValue="{Binding UsedPercent}"
                                                 Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 3. Santé des disques -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=2}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Disks}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                                <DockPanel>
                                    <ContentControl DockPanel.Dock="Left" Style="{StaticResource StatusIcon}" Content="{Binding Status}"
                                                    Margin="0,0,16,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Kind}" Style="{StaticResource SmallMutedText}" />
                                        <TextBlock Text="{Binding HealthText}" Margin="0,8,0,0" TextWrapping="Wrap"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />
                                        <TextBlock Text="{Binding Details}" Style="{StaticResource SmallMutedText}"
                                                   Visibility="{Binding Details, Converter={StaticResource EqualsToVis}, ConverterParameter=!}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding SmartSummary}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="4,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- 4. Sécurité (lecture seule) -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=3}">
            <StackPanel>
                <Border Style="{StaticResource Card}">
                    <ItemsControl ItemsSource="{Binding SecurityLines}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl Style="{StaticResource StatusIcon}" Content="{Binding Status}" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="{Binding Label}" Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Value}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="Ouvrir Windows Update" Command="{Binding OpenWindowsUpdateCommand}" />
                    <Button Style="{StaticResource GhostButton}" Content="Ouvrir Sécurité Windows" Margin="10,0,0,0"
                            Command="{Binding OpenWindowsSecurityCommand}" />
                </StackPanel>
                <TextBlock Text="Cette page ne fait que lire l'état de la protection. Les réglages se font dans Windows."
                           Style="{StaticResource SmallMutedText}" Margin="4,12,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>

        <!-- 5. Espace disque : qu'est-ce qui prend de la place ? -->
        <Grid Grid.Row="2" Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=4}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,12">
                <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="110"
                        Command="{Binding ScanSpaceCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content" Value="Mesurer" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Content" Value="Annuler" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding SpaceStatus}" Style="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False"
                          Visibility="{Binding HasSpaceResult, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="Dossiers du disque système" FontSize="12" FontWeight="SemiBold" Margin="2,4,0,8"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <ItemsControl ItemsSource="{Binding Folders}" ItemTemplate="{StaticResource FolderRow}" Focusable="False" />
                    <TextBlock Text="Tes dossiers personnels" FontSize="12" FontWeight="SemiBold" Margin="2,14,0,8"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <ItemsControl ItemsSource="{Binding UserFolders}" ItemTemplate="{StaticResource FolderRow}" Focusable="False" />
                    <TextBlock Text="Plus gros fichiers (plus de 100 Mo)" FontSize="12" FontWeight="SemiBold" Margin="2,14,0,8"
                               Foreground="{StaticResource TextMutedBrush}" />
                    <ItemsControl ItemsSource="{Binding BigFiles}" ItemTemplate="{StaticResource FolderRow}" Focusable="False" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 6. Réparation -->
        <Grid Grid.Row="2" Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=5}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <UniformGrid Rows="1" Margin="-5,0">
                <Button Style="{StaticResource CardButton}" Margin="5,0" Padding="16" Command="{Binding SfcCommand}"
                        ToolTip="Windows vérifie ses propres fichiers et remplace ceux qui sont abîmés. Sans risque, 10 à 20 minutes. À faire si Windows plante ou se comporte bizarrement.">
                    <StackPanel>
                        <TextBlock Text="&#xE9D9;" Style="{StaticResource IconText}" HorizontalAlignment="Left"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Vérifier les fichiers système" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Si Windows plante" Style="{StaticResource SmallMutedText}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CardButton}" Margin="5,0" Padding="16" Command="{Binding DismCommand}"
                        ToolTip="Répare l'image de Windows en téléchargeant les fichiers sains chez Microsoft. Sans risque, 10 à 30 minutes. À faire si la vérification des fichiers système n'a pas tout réparé.">
                    <StackPanel>
                        <TextBlock Text="&#xE90F;" Style="{StaticResource IconText}" HorizontalAlignment="Left"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Réparer l'image Windows" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Si la vérification échoue" Style="{StaticResource SmallMutedText}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CardButton}" Margin="5,0" Padding="16" Command="{Binding NetworkCommand}"
                        ToolTip="Vide le cache DNS et réinitialise la connexion réseau de Windows. Sans risque pour tes fichiers ; il faut redémarrer le PC ensuite. À faire si Internet ne marche plus alors que la box fonctionne.">
                    <StackPanel>
                        <TextBlock Text="&#xE774;" Style="{StaticResource IconText}" HorizontalAlignment="Left"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Réparer la connexion Internet" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Si Internet ne marche plus" Style="{StaticResource SmallMutedText}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CardButton}" Margin="5,0" Padding="16" Command="{Binding RestorePointCommand}"
                        ToolTip="Enregistre l'état actuel de Windows. En cas de problème, on peut y revenir depuis « Créer un point de restauration » dans le menu Démarrer. Tes fichiers personnels ne sont pas concernés.">
                    <StackPanel>
                        <TextBlock Text="&#xE81C;" Style="{StaticResource IconText}" HorizontalAlignment="Left"
                                   Foreground="{StaticResource AccentBrush}" />
                        <TextBlock Text="Créer un point de restauration" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                        <TextBlock Text="Pour revenir en arrière" Style="{StaticResource SmallMutedText}" />
                    </StackPanel>
                </Button>
            </UniformGrid>

            <Grid Grid.Row="1" Margin="0,16,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding RepairStatus}" TextWrapping="Wrap" />
                    <ProgressBar Margin="0,10,0,0" Maximum="100" c:Behaviors.SmoothValue="{Binding Progress}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="Annuler" Margin="16,0,0,0"
                        VerticalAlignment="Center" Command="{Binding CancelCommand}"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            </Grid>

            <TextBox Grid.Row="2" Style="{StaticResource LogBox}" Text="{Binding RepairLog.Text, Mode=OneWay}" />
        </Grid>
    </Grid>
</UserControl>
