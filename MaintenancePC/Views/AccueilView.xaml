<UserControl x:Class="MaintenancePC.Views.AccueilView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MaintenancePC.Controls">
    <Grid Margin="32,24,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Le gros bouton « Analyser », au centre -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560">
            <c:RingButton Width="190" Height="190"
                          Command="{Binding RingCommand}" IsBusy="{Binding IsBusy}" Progress="{Binding Progress}"
                          Content="{Binding RingText}" Caption="{Binding RingCaption}" />
            <TextBlock Text="{Binding Headline}" Style="{StaticResource HeadlineText}"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,26,0,0" />
            <TextBlock Text="{Binding SubText}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0" MaxHeight="40" />
        </StackPanel>

        <!-- Les trois cartes de résumé : un clic ouvre l'onglet correspondant -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Cards}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource CardButton}" Margin="6,0"
                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}">
                        <StackPanel>
                            <DockPanel>
                                <ContentControl DockPanel.Dock="Right" Style="{StaticResource StatusIcon}" Content="{Binding Status}" />
                                <TextBlock Text="{Binding Icon}" Style="{StaticResource IconText}" FontSize="16"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </DockPanel>
                            <TextBlock Text="{Binding Value}" FontSize="30" FontWeight="SemiBold" Margin="0,12,0,0" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource SmallMutedText}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
