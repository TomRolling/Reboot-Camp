<UserControl x:Class="MaintenancePC.Views.PilotesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MaintenancePC.Controls">
    <Grid Margin="32,28,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- En-tête : bouton rond + résultat -->
        <Grid Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <c:RingButton Width="128" Height="128"
                          Command="{Binding RingCommand}" IsBusy="{Binding IsBusy}" Progress="{Binding Progress}"
                          Content="{Binding RingText}" Caption="{Binding RingCaption}" />
            <StackPanel Grid.Column="1" Margin="26,0,16,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Headline}" Style="{StaticResource HeadlineText}" />
                <TextBlock Text="{Binding SubText}" Style="{StaticResource MutedText}" TextWrapping="Wrap"
                           Margin="0,6,0,0" MaxHeight="40" />
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="Pilotes NVIDIA" Command="{Binding OpenNvidiaCommand}"
                        ToolTip="Ouvre la page de téléchargement officielle de NVIDIA dans ton navigateur" />
                <Button Style="{StaticResource GhostButton}" Content="Support Asus" Command="{Binding OpenAsusCommand}"
                        Margin="0,8,0,0" ToolTip="Ouvre la page de support officielle d'Asus dans ton navigateur" />
            </StackPanel>
        </Grid>

        <!-- Résultats (affichés après la première analyse) -->
        <Grid Grid.Row="1" Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ListBox Style="{StaticResource SegmentedTabs}" ItemsSource="{Binding Tabs}"
                     SelectedIndex="{Binding SelectedTab}" Margin="0,0,0,12" />

            <!-- 1. Mises à jour disponibles -->
            <Grid Grid.Row="1" Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=0}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding UpdatesMessage}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="14,10"
                           Visibility="{Binding Updates.Count, Converter={StaticResource EqualsToVis}, ConverterParameter=0}" />

                <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding Updates}"
                         Visibility="{Binding Updates.Count, Converter={StaticResource EqualsToVis}, ConverterParameter=!0}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsSelected}" />
                                <StackPanel Grid.Column="1" Margin="14,0">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource SmallMutedText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding StatusText}" Style="{StaticResource MutedText}"
                                           VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="260" />
                                <ContentControl Grid.Column="3" Style="{StaticResource StatusIcon}" Content="{Binding Status}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <DockPanel Grid.Row="1" Margin="0,14,0,0" LastChildFill="False"
                           Visibility="{Binding Updates.Count, Converter={StaticResource EqualsToVis}, ConverterParameter=!0}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Installer la sélection"
                            Command="{Binding InstallCommand}" />
                    <CheckBox DockPanel.Dock="Left" Margin="14,0,0,0" IsChecked="{Binding CreateRestorePoint}"
                              Content="Créer un point de restauration avant (recommandé)" />
                </DockPanel>
            </Grid>

            <!-- 2. Périphériques en erreur -->
            <Grid Grid.Row="1" Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=1}">
                <TextBlock Text="Aucun périphérique en erreur. Tout fonctionne." Style="{StaticResource MutedText}" Margin="14,10"
                           Visibility="{Binding Problems.Count, Converter={StaticResource EqualsToVis}, ConverterParameter=0}" />
                <ListBox Style="{StaticResource RowList}" ItemsSource="{Binding Problems}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel>
                                <ContentControl DockPanel.Dock="Left" Style="{StaticResource StatusIcon}" Content="{Binding Status}" />
                                <StackPanel Margin="14,0,0,0">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Explanation}" Style="{StaticResource SmallMutedText}" />
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <!-- 3. Tous les pilotes installés -->
            <Grid Grid.Row="1" Visibility="{Binding SelectedTab, Converter={StaticResource EqualsToVis}, ConverterParameter=2}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <TextBox Style="{StaticResource SearchBox}" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Rechercher un pilote ou un fabricant…" Margin="12,0" VerticalAlignment="Center"
                               IsHitTestVisible="False" Foreground="{StaticResource TextMutedBrush}"
                               Visibility="{Binding FilterText, Converter={StaticResource EqualsToVis}, ConverterParameter=''}" />
                </Grid>
                <ListBox Grid.Row="1" Style="{StaticResource RowList}" ItemsSource="{Binding Drivers}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Manufacturer}" Style="{StaticResource SmallMutedText}" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Version}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Date}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                           TextAlignment="Right" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
